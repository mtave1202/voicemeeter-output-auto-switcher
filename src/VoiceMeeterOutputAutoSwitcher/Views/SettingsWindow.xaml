<Window x:Class="VoiceMeeterOutputAutoSwitcher.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="設定 - VoiceMeeter Output Auto Switcher"
        Height="560"
        Width="760"
        MinHeight="480"
        MinWidth="640"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/app-icon.ico">
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="再読み込み" Width="100" Margin="0,0,8,0" Click="Reload_Click"/>
      <Button Content="保存" Width="100" Margin="0,0,8,0" Click="Save_Click" IsDefault="True"/>
      <Button Content="閉じる" Width="100" Click="Close_Click" IsCancel="True"/>
    </StackPanel>

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*" MinHeight="180"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <TextBlock Grid.Row="0" Text="自動管理する出力デバイス" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
      <TextBlock Grid.Row="1" TextWrapping="Wrap" Margin="0,0,0,8"
                 Text="チェックしたデバイスが Active のとき、優先順位の高い順に最大2台を A2 / A3 へ割り当てます。デバイス名の手入力は不要です。"/>

      <DataGrid Grid.Row="2"
                x:Name="DevicesGrid"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                HeadersVisibility="Column"
                SelectionMode="Single"
                Margin="0,0,0,12">
        <DataGrid.Columns>
          <DataGridCheckBoxColumn Header="管理" Binding="{Binding IsManaged, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
          <DataGridCheckBoxColumn Header="有効" Binding="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
          <DataGridTextColumn Header="デバイス名" Binding="{Binding FriendlyName}" IsReadOnly="True" Width="*"/>
          <DataGridTextColumn Header="状態" Binding="{Binding State}" IsReadOnly="True" Width="100"/>
          <DataGridTextColumn Header="優先順位" Binding="{Binding Priority, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
        </DataGrid.Columns>
      </DataGrid>

      <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,12">
        <Button Content="優先度を上げる" Width="120" Margin="0,0,8,0" Click="MoveUp_Click"/>
        <Button Content="優先度を下げる" Width="120" Click="MoveDown_Click"/>
      </StackPanel>

      <CheckBox Grid.Row="4"
                x:Name="StartWithWindowsCheck"
                Content="Windows 起動時に自動起動する"
                Margin="0,0,0,12"/>

      <StackPanel Grid.Row="5" Orientation="Horizontal">
        <TextBlock Text="反映待ち時間 (ms)" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <TextBox x:Name="DebounceBox"
                 Width="80"
                 Height="28"
                 VerticalContentAlignment="Center"
                 Text="500"/>
        <TextBlock Text="デバイス変化後、VoiceMeeter へ反映するまでの待ち時間（500〜1500）"
                   VerticalAlignment="Center"
                   Margin="12,0,0,0"
                   Foreground="Gray"
                   TextWrapping="Wrap"/>
      </StackPanel>
    </Grid>
  </DockPanel>
</Window>
